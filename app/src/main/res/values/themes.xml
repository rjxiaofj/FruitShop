<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 应用主题：无标题栏，标题栏由 include_title_bar.xml 自己画 -->
    <style name="Theme.FruitShop" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/bgPage</item>
        <item name="android:textColorPrimary">@color/textMain</item>
        <item name="android:textColorSecondary">@color/textSub</item>
    </style>

    <!-- 启动页主题，窗口背景直接用绿色渐变，避免启动瞬间白屏 -->
    <style name="Theme.FruitShop.Splash" parent="Theme.FruitShop">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <!-- 商品详情用的对话框式 Activity 主题 -->
    <style name="Theme.FruitShop.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimStyle</item>
    </style>

    <style name="DialogAnimStyle">
        <item name="android:windowEnterAnimation">@anim/slide_bottom_to_top</item>
        <item name="android:windowExitAnimation">@anim/slide_top_to_bottom</item>
    </style>

    <!-- 购物车明细弹窗，从底部滑出 -->
    <style name="Theme.FruitShop.BottomSheet" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimStyle</item>
    </style>

    <!-- 通用提示弹窗 -->
    <style name="Theme.FruitShop.Alert" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
